# ============================================================================
# SOS SANG - variables d'environnement (aucun secret reel ici)
# Copier en .env puis remplacer les valeurs. Ne JAMAIS committer .env
# ============================================================================

NODE_ENV=development

# --- Securite ---------------------------------------------------------------
# Generer avec: openssl rand -hex 48
JWT_SECRET=change-me-openssl-rand-hex-48
JWT_EXPIRES_IN=12h

# --- PostgreSQL -------------------------------------------------------------
# En docker compose: postgres://sos:CHANGE_ME@postgres:5432/sos_sang
# En local (embedded, sans Docker): laisser vide -> PGlite sur ./.pglite
DATABASE_URL=postgres://sos:change-me@localhost:5432/sos_sang

# Schema logique par service (separation des donnees, proprietaire unique)
AUTH_DB_SCHEMA=auth
DONOR_DB_SCHEMA=donor
HOSPITAL_DB_SCHEMA=hospital
MATCHING_DB_SCHEMA=matching
NOTIFICATION_DB_SCHEMA=notification
STOCK_DB_SCHEMA=stock
DASHBOARD_DB_SCHEMA=dashboard

# --- Redis ------------------------------------------------------------------
# Laisser vide pour utiliser le cache memoire (mode developpement uniquement)
REDIS_URL=redis://redis:6379

# --- RabbitMQ ---------------------------------------------------------------
# Laisser vide pour utiliser le bus memoire (mode developpement uniquement)
AMQP_URL=amqp://sos:change-me@rabbitmq:5672

# --- Ports (mode local / docker) -------------------------------------------
API_GATEWAY_PORT=8080
AUTH_PORT=4001
DONOR_PORT=4002
HOSPITAL_PORT=4003
MATCHING_PORT=4004
NOTIFICATION_PORT=4005
STOCK_PORT=4006
DASHBOARD_PORT=4007

# --- URLs internes utilisees par la gateway --------------------------------
AUTH_URL=http://localhost:4001
DONOR_URL=http://localhost:4002
HOSPITAL_URL=http://localhost:4003
MATCHING_URL=http://localhost:4004
NOTIFICATION_URL=http://localhost:4005
STOCK_URL=http://localhost:4006
DASHBOARD_URL=http://localhost:4007

# --- Regles metier ----------------------------------------------------------
ELIGIBILITY_MIN_INTERVAL_DAYS=90
ELIGIBILITY_MIN_AGE=18
ELIGIBILITY_MAX_AGE=65
ELIGIBILITY_MIN_WEIGHT_KG=50
MATCHING_RADII_KM=25,50,100,200
MATCHING_MAX_ALERTS=40

# --- Compte administrateur initial -----------------------------------------
# NE PAS mettre de mot de passe ici en production.
# Option 1: ADMIN_EMAIL + ADMIN_INITIAL_PASSWORD (injectes par un secret manager)
# Option 2: npm run create-admin -- admin@sos-sang.local  (mot de passe aleatoire affiche une fois)
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# --- Notifications (simulation) --------------------------------------------
NOTIFICATION_EMAIL_MODE=simulated
NOTIFICATION_SMS_MODE=simulated
PUBLIC_BASE_URL=http://localhost:5173

# Limites de debit des routes sensibles (valeurs de developpement)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=20

# Frontend : laisser vide en developpement (proxy Vite vers /api).
# En production, le SPA est servi par Nginx qui proxifie /api et /socket.io.
VITE_API_URL=
