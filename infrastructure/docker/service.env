# Variables communes aux microservices (valeurs de developpement, sans secret).
# Les secrets (JWT_SECRET, INTERNAL_API_TOKEN, mots de passe) sont fournis par
# docker-compose.yml via le fichier .env, jamais versionnes.
NODE_ENV=production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
PUBLIC_BASE_URL=http://localhost:3000
ELIGIBILITY_MIN_INTERVAL_DAYS=90
ELIGIBILITY_MIN_AGE=18
ELIGIBILITY_MAX_AGE=65
ELIGIBILITY_MIN_WEIGHT_KG=50
MATCHING_RADII_KM=25,50,100,200
MATCHING_MAX_ALERTS=50
NOTIFICATION_EMAIL_MODE=simulated
NOTIFICATION_SMS_MODE=simulated
AUTH_SERVICE_URL=http://auth-service:4001
DONOR_SERVICE_URL=http://donor-service:4002
HOSPITAL_SERVICE_URL=http://hospital-service:4003
MATCHING_SERVICE_URL=http://matching-service:4004
NOTIFICATION_SERVICE_URL=http://notification-service:4005
STOCK_SERVICE_URL=http://stock-service:4006
DASHBOARD_SERVICE_URL=http://dashboard-service:4007
